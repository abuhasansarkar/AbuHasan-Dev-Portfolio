# ─────────────────────────────────────────────────────────────
# Database (PostgreSQL)
# Local: `docker compose up -d` starts a Postgres instance matching this URL.
# Production: Neon, Supabase, Railway, Vercel Postgres, etc.
# Optional: Neon branching/migrations use the unpooled URL when present.
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio?schema=public"
# DATABASE_URL_UNPOOLED=""
# NEON_BRANCH=production

# ─────────────────────────────────────────────────────────────
# Authentication
# AUTH_SECRET signs the admin session cookie. Generate one with:
#   openssl rand -base64 32
# ─────────────────────────────────────────────────────────────
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Initial admin account. These are DEMO credentials for local development.
# The seed script creates this account (password is hashed with bcrypt).
# !!! CHANGE THESE BEFORE ANY PRODUCTION DEPLOYMENT !!!
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeThisImmediately123!"
ADMIN_NAME="AbuHasan"

# ─────────────────────────────────────────────────────────────
# Rate limiting backend (optional)
# When BOTH are set, login/contact rate limiting uses Upstash Redis (works
# across serverless instances/regions). Without them a per-process in-memory
# limiter is used (single-instance deployments only).
# ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# Analytics (all optional – leave empty to disable)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_META_PIXEL_ID=""

# ─────────────────────────────────────────────────────────────
# ImageKit Configuration (Primary Media Provider)
# Real-time image & video optimization, transforms, and uploads
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your-imagekit-id"
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="your-imagekit-public-key"
IMAGEKIT_PRIVATE_KEY="your-imagekit-private-key"
IMAGEKIT_ID="your-imagekit-id"
IMAGEKIT_FOLDER_NAME="Developer-Portfolio"
# IMAGEKIT_FOLDER_ID=""

# ─────────────────────────────────────────────────────────────
# Image uploads (fallback/legacy)
# When set, admin uploads can also use Vercel Blob.
# When empty, uploads are written to ImageKit or public/uploads.
# ─────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=""
